+	env, _ := newTestEnv(t, f)
+	ctx := context.Background()
+
+	require.NoError(t, env.Copy("/__w/_act/", &container.FileEntry{Name: "workflow/event.json", Mode: 0o644, Body: `{"a":1}`})(ctx))
+	b, err := os.ReadFile(filepath.Join(f.Root, "__w/_act/workflow/event.json"))
+	require.NoError(t, err)
