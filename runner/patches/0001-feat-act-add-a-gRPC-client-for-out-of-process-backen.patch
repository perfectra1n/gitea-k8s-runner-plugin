diff --git a/act/plugin/client.go b/act/plugin/client.go
new file mode 100644
index 0000000..b052812
--- /dev/null
+++ b/act/plugin/client.go
@@ -0,0 +1,92 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+// Package plugin runs jobs on out-of-process backend plugins that speak the
+// plugin.v1alpha gRPC protocol (wire-compatible with Forgejo runner's backend
+// plugins). A plugin owns the execution environment (a Kubernetes pod, a VM,
+// ...); the runner keeps everything else.
+package plugin
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	pluginv1alpha "gitea.com/gitea/runner/act/plugin/proto/v1alpha"
+	"gitea.com/gitea/runner/act/plugin/proto/v1alpha/pluginv1alphaconnect"
+
+	"connectrpc.com/connect"
+)
+
+// dialTimeout bounds the Capabilities handshake in Dial.
+const dialTimeout = 30 * time.Second
+
+// Client is a connection to one plugin.
+type Client struct {
+	name      string
+	address   string
+	backend   string
+	transport *http.Transport
+	rpc       pluginv1alphaconnect.BackendPluginClient
+}
+
+// Dial connects to the plugin configured as name at address ("unix:///path"
+// or "tcp://host:port") and performs the Capabilities handshake. Plugins
+// speak plain gRPC over HTTP/2 without TLS.
+func Dial(ctx context.Context, name, address string) (*Client, error) {
+	c, err := newClient(name, address)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, dialTimeout)
+	defer cancel()
+	resp, err := c.rpc.Capabilities(ctx, connect.NewRequest(&pluginv1alpha.CapabilitiesRequest{}))
+	if err != nil {
+		c.transport.CloseIdleConnections()
+		return nil, c.wrap(err)
+	}
+	c.backend = resp.Msg.GetName()
+	return c, nil
+}
+
+func newClient(name, address string) (*Client, error) {
+	c := &Client{name: name, address: address}
+	protocols := new(http.Protocols)
+	protocols.SetUnencryptedHTTP2(true)
+	c.transport = &http.Transport{Protocols: protocols}
+	var base string
+	switch {
+	case strings.HasPrefix(address, "unix://"):
+		path := strings.TrimPrefix(address, "unix://")
+		if path == "" {
+			return nil, c.wrap(errors.New("empty unix socket path"))
+		}
+		c.transport.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, "unix", path)
+		}
+		base = "http://plugin"
+	case strings.HasPrefix(address, "tcp://"):
+		host := strings.TrimPrefix(address, "tcp://")
+		if host == "" {
+			return nil, c.wrap(errors.New("empty tcp address"))
+		}
+		base = "http://" + host
+	default:
+		return nil, c.wrap(errors.New("address must be unix:///path or tcp://host:port"))
+	}
+	c.rpc = pluginv1alphaconnect.NewBackendPluginClient(&http.Client{Transport: c.transport}, base, connect.WithGRPC())
+	return c, nil
+}
+
+// BackendName is the name the plugin reported in Capabilities.
+func (c *Client) BackendName() string { return c.backend }
+
+// wrap prefixes errors so the job log says which plugin failed.
+func (c *Client) wrap(err error) error {
+	return fmt.Errorf("plugin %s at %s: %w", c.name, c.address, err)
+}
diff --git a/act/plugin/environment.go b/act/plugin/environment.go
new file mode 100644
index 0000000..8a0571c
--- /dev/null
+++ b/act/plugin/environment.go
@@ -0,0 +1,510 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package plugin
+
+import (
+	"archive/tar"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"gitea.com/gitea/runner/act/common"
+	"gitea.com/gitea/runner/act/container"
+	"gitea.com/gitea/runner/act/filecollector"
+	pluginv1alpha "gitea.com/gitea/runner/act/plugin/proto/v1alpha"
+
+	"connectrpc.com/connect"
+	"github.com/go-git/go-billy/v5/helper/polyfill"
+	"github.com/go-git/go-billy/v5/osfs"
+	"github.com/go-git/go-git/v5/plumbing/format/gitignore"
+	"google.golang.org/protobuf/types/known/durationpb"
+)
+
+const (
+	// chunkSize bounds each CopyIn message.
+	chunkSize = 64 * 1024
+	// removeTimeout bounds Remove, which runs during cleanup, possibly after
+	// the job context was cancelled.
+	removeTimeout = 2 * time.Minute
+	defaultPath   = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
+)
+
+// ServiceSpec is one workflow `services:` entry, already interpolated.
+type ServiceSpec struct {
+	Name  string
+	Image string
+	Env   map[string]string
+	Ports []string
+}
+
+// Environment is a job environment owned by a plugin. It implements
+// container.ExecutionsEnvironment by mapping each operation onto an RPC.
+type Environment struct {
+	client   *Client
+	input    *container.NewContainerInput
+	services []ServiceSpec
+	options  map[string]string
+	labelArg string
+	timeout  time.Duration
+
+	mu       sync.Mutex
+	stdout   io.Writer
+	stderr   io.Writer
+	id       string
+	layout   *pluginv1alpha.CreateResponse
+	imageEnv map[string]string
+	removed  bool
+}
+
+var _ container.ExecutionsEnvironment = (*Environment)(nil)
+
+// NewEnvironment describes an environment; nothing is sent until Create.
+// input supplies the job image, name, working directory and log writers.
+func (c *Client) NewEnvironment(input *container.NewContainerInput, services []ServiceSpec, options map[string]string, labelArg string, timeout time.Duration) *Environment {
+	return &Environment{
+		client:   c,
+		input:    input,
+		services: services,
+		options:  options,
+		labelArg: labelArg,
+		timeout:  timeout,
+		stdout:   orDiscard(input.Stdout),
+		stderr:   orDiscard(input.Stderr),
+		layout:   &pluginv1alpha.CreateResponse{},
+	}
+}
+
+func orDiscard(w io.Writer) io.Writer {
+	if w == nil {
+		return io.Discard
+	}
+	return w
+}
+
+func (e *Environment) Create(capAdd, capDrop []string) common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		req := &pluginv1alpha.CreateRequest{
+			Image:          e.input.Image,
+			Name:           e.input.Name,
+			CapAdd:         capAdd,
+			CapDrop:        capDrop,
+			BackendOptions: e.options,
+			LabelArg:       e.labelArg,
+		}
+		if e.timeout > 0 {
+			req.EnvironmentTimeout = durationpb.New(e.timeout)
+		}
+		for _, s := range e.services {
+			req.Services = append(req.Services, &pluginv1alpha.ServiceContainer{Name: s.Name, Image: s.Image, Env: s.Env, Ports: s.Ports})
+		}
+		resp, err := e.client.rpc.Create(ctx, connect.NewRequest(req))
+		if err != nil {
+			return e.client.wrap(err)
+		}
+		e.mu.Lock()
+		e.id = resp.Msg.GetEnvironmentId()
+		e.layout = resp.Msg
+		e.mu.Unlock()
+		return nil
+	}).IfNot(common.Dryrun)
+}
+
+func (e *Environment) Start(_ bool) common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		stream, err := e.client.rpc.Start(ctx, connect.NewRequest(&pluginv1alpha.StartRequest{EnvironmentId: e.id}))
+		if err != nil {
+			return e.client.wrap(err)
+		}
+		defer stream.Close()
+		for stream.Receive() {
+			switch out := stream.Msg().GetOutput().(type) {
+			case *pluginv1alpha.StartOutput_Data:
+				_, _ = e.writer(out.Data.GetStream()).Write(out.Data.GetData())
+			case *pluginv1alpha.StartOutput_StartComplete:
+				e.mu.Lock()
+				e.imageEnv = out.StartComplete.GetImageEnv()
+				e.mu.Unlock()
+				return nil
+			}
+		}
+		if err := stream.Err(); err != nil {
+			return e.client.wrap(err)
+		}
+		return e.client.wrap(errors.New("start ended without completing"))
+	}).IfNot(common.Dryrun)
+}
+
+// Pull is a no-op: the plugin pulls images when it starts the environment.
+func (e *Environment) Pull(_ bool) common.Executor {
+	return func(context.Context) error { return nil }
+}
+
+func (e *Environment) Exec(command []string, env map[string]string, user, workdir string) common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		common.Logger(ctx).Debugf("plugin exec cmd=[%s] user=%s workdir=%s", strings.Join(command, " "), user, workdir)
+		req := &pluginv1alpha.ExecRequest{
+			EnvironmentId: e.id,
+			Command:       command,
+			Env:           env,
+			Workdir:       e.containerWorkdir(workdir),
+		}
+		if user != "" {
+			req.User = &user
+		}
+		stream, err := e.client.rpc.Exec(ctx, connect.NewRequest(req))
+		if err != nil {
+			return e.client.wrap(err)
+		}
+		defer stream.Close()
+		for stream.Receive() {
+			switch out := stream.Msg().GetOutput().(type) {
+			case *pluginv1alpha.ExecOutput_Data:
+				_, _ = e.writer(out.Data.GetStream()).Write(out.Data.GetData())
+			case *pluginv1alpha.ExecOutput_ExecComplete:
+				if code := out.ExecComplete.GetExitCode(); code != 0 {
+					return container.ExitCodeError(code)
+				}
+				return nil
+			case *pluginv1alpha.ExecOutput_ExecFailed:
+				return e.client.wrap(errors.New(out.ExecFailed.GetErrorMessage()))
+			}
+		}
+		if err := stream.Err(); err != nil {
+			return e.client.wrap(err)
+		}
+		return e.client.wrap(errors.New("exec ended without an exit code"))
+	}).IfNot(common.Dryrun)
+}
+
+// containerWorkdir resolves workdir the way the docker backend does: relative
+// paths are taken from the job's working directory.
+func (e *Environment) containerWorkdir(workdir string) string {
+	base := e.ToContainerPath(e.input.WorkingDir)
+	switch {
+	case workdir == "":
+		return base
+	case strings.HasPrefix(workdir, "/"):
+		return workdir
+	}
+	return path.Join(base, workdir)
+}
+
+func (e *Environment) writer(s pluginv1alpha.DataChunk_Stream) io.Writer {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if s == pluginv1alpha.DataChunk_STDERR {
+		return e.stderr
+	}
+	return e.stdout
+}
+
+func (e *Environment) ReplaceLogWriter(stdout, stderr io.Writer) (io.Writer, io.Writer) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	oldOut, oldErr := e.stdout, e.stderr
+	e.stdout, e.stderr = orDiscard(stdout), orDiscard(stderr)
+	return oldOut, oldErr
+}
+
+func (e *Environment) Copy(destPath string, files ...*container.FileEntry) common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		var buf bytes.Buffer
+		tw := tar.NewWriter(&buf)
+		for _, f := range files {
+			if err := tw.WriteHeader(&tar.Header{Name: f.Name, Mode: f.Mode, Size: int64(len(f.Body))}); err != nil {
+				return err
+			}
+			if _, err := io.WriteString(tw, f.Body); err != nil {
+				return err
+			}
+		}
+		if err := tw.Close(); err != nil {
+			return err
+		}
+		return e.copyIn(ctx, destPath, func(w io.Writer) error {
+			_, err := w.Write(buf.Bytes())
+			return err
+		})
+	}).IfNot(common.Dryrun)
+}
+
+// CopyDir sends srcPath as a tar whose entries carry destPath, extracted at
+// "/" — the same archive layout the docker backend builds.
+func (e *Environment) CopyDir(destPath, srcPath string, useGitIgnore, skipGitDir bool) common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		logger := common.Logger(ctx)
+		logger.Infof("plugin cp src=%s dst=%s", srcPath, destPath)
+		srcPrefix := filepath.Dir(srcPath)
+		if !strings.HasSuffix(srcPrefix, string(filepath.Separator)) {
+			srcPrefix += string(filepath.Separator)
+		}
+		var ignorer gitignore.Matcher
+		if useGitIgnore {
+			ps, err := gitignore.ReadPatterns(polyfill.New(osfs.New(srcPath)), nil)
+			if err != nil {
+				logger.Debugf("Error loading .gitignore: %v", err)
+			}
+			ignorer = gitignore.NewMatcher(ps)
+		}
+		return e.copyIn(ctx, "/", func(w io.Writer) error {
+			tw := tar.NewWriter(w)
+			fc := &filecollector.FileCollector{
+				Ignorer:    ignorer,
+				SrcPath:    srcPath,
+				SrcPrefix:  srcPrefix,
+				SkipGitDir: skipGitDir,
+				Handler:    &filecollector.TarCollector{TarWriter: tw, DstDir: strings.TrimPrefix(destPath, "/")},
+			}
+			if err := filepath.Walk(srcPath, fc.CollectFiles(ctx, []string{})); err != nil {
+				return err
+			}
+			return tw.Close()
+		})
+	}).IfNot(common.Dryrun)
+}
+
+// copyIn streams the tar produced by fill into the environment at dest.
+func (e *Environment) copyIn(ctx context.Context, dest string, fill func(io.Writer) error) error {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stream := e.client.rpc.CopyIn(ctx)
+	w := &chunkSender{send: func(b []byte, first bool) error {
+		chunk := &pluginv1alpha.CopyInChunk{Data: b}
+		if first {
+			chunk.EnvironmentId = &e.id
+			chunk.DestPath = &dest
+		}
+		return stream.Send(chunk)
+	}}
+	fillErr := fill(w)
+	if fillErr == nil {
+		fillErr = w.flush()
+	}
+	switch {
+	case errors.Is(fillErr, io.EOF):
+		fillErr = nil // a failed send: CloseAndReceive has the plugin's reason
+	case fillErr != nil:
+		cancel() // abort, so the plugin does not extract a partial archive
+	}
+	_, err := stream.CloseAndReceive()
+	if fillErr != nil {
+		fillErr = fmt.Errorf("copy to %s: %w", dest, fillErr)
+	}
+	if err != nil {
+		err = e.client.wrap(fmt.Errorf("copy to %s: %w", dest, err))
+	}
+	return errors.Join(fillErr, err)
+}
+
+type chunkSender struct {
+	buf  []byte
+	sent bool
+	send func([]byte, bool) error
+}
+
+func (c *chunkSender) Write(p []byte) (int, error) {
+	n := 0
+	for len(p) > 0 {
+		k := min(chunkSize-len(c.buf), len(p))
+		c.buf = append(c.buf, p[:k]...)
+		p, n = p[k:], n+k
+		if len(c.buf) == chunkSize {
+			if err := c.flush(); err != nil {
+				return n, err
+			}
+		}
+	}
+	return n, nil
+}
+
+func (c *chunkSender) flush() error {
+	if len(c.buf) == 0 && c.sent {
+		return nil
+	}
+	err := c.send(c.buf, !c.sent)
+	c.sent = true
+	c.buf = c.buf[:0]
+	return err
+}
+
+// GetContainerArchive streams a tar of srcPath out of the environment. The
+// first chunk is read eagerly so a missing path fails here, as with docker.
+func (e *Environment) GetContainerArchive(ctx context.Context, srcPath string) (io.ReadCloser, error) {
+	if common.Dryrun(ctx) {
+		return nil, errors.New("DRYRUN is not supported in GetContainerArchive")
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	stream, err := e.client.rpc.CopyOut(ctx, connect.NewRequest(&pluginv1alpha.CopyOutRequest{EnvironmentId: e.id, SrcPath: srcPath}))
+	if err != nil {
+		cancel()
+		return nil, e.client.wrap(err)
+	}
+	r := &archiveReader{stream: stream, cancel: cancel}
+	if !stream.Receive() {
+		defer r.Close()
+		if err := stream.Err(); err != nil {
+			return nil, e.client.wrap(fmt.Errorf("copy from %s: %w", srcPath, err))
+		}
+		return nil, e.client.wrap(fmt.Errorf("copy from %s: empty archive", srcPath))
+	}
+	r.cur = stream.Msg().GetData()
+	return r, nil
+}
+
+type archiveReader struct {
+	stream interface {
+		Receive() bool
+		Msg() *pluginv1alpha.CopyOutChunk
+		Err() error
+		Close() error
+	}
+	cancel context.CancelFunc
+	cur    []byte
+}
+
+func (r *archiveReader) Read(p []byte) (int, error) {
+	for len(r.cur) == 0 {
+		if !r.stream.Receive() {
+			if err := r.stream.Err(); err != nil {
+				return 0, err
+			}
+			return 0, io.EOF
+		}
+		r.cur = r.stream.Msg().GetData()
+	}
+	n := copy(p, r.cur)
+	r.cur = r.cur[n:]
+	return n, nil
+}
+
+func (r *archiveReader) Close() error {
+	r.cancel()
+	return r.stream.Close()
+}
+
+func (e *Environment) UpdateFromEnv(srcPath string, env *map[string]string) common.Executor {
+	return container.ParseEnvFile(e, srcPath, env).IfNot(common.Dryrun)
+}
+
+// UpdateFromImageEnv merges the environment the plugin reported for the job
+// image at Start, with the docker backend's rules: PATH is appended, other
+// variables only fill gaps.
+func (e *Environment) UpdateFromImageEnv(env *map[string]string) common.Executor {
+	return common.Executor(func(context.Context) error {
+		e.mu.Lock()
+		defer e.mu.Unlock()
+		m := *env
+		for k, v := range e.imageEnv {
+			switch {
+			case k == "PATH" && m[k] != "":
+				m[k] += ":" + v
+			case m[k] == "":
+				m[k] = v
+			}
+		}
+		return nil
+	}).IfNot(common.Dryrun)
+}
+
+// Inspect reports the environment as running: the plugin fails Start and
+// Exec when it is not.
+func (e *Environment) Inspect(context.Context) (*container.Info, error) {
+	return &container.Info{
+		ID: e.id, State: container.StateRunning, Health: container.HealthNone,
+		Ports: map[string]string{}, Mounts: map[string]string{},
+	}, nil
+}
+
+// DumpLogs is a no-op: step output is streamed live.
+func (e *Environment) DumpLogs(context.Context) error { return nil }
+
+func (e *Environment) Remove() common.Executor {
+	return common.Executor(func(ctx context.Context) error {
+		e.mu.Lock()
+		id, removed := e.id, e.removed
+		e.removed = true
+		e.mu.Unlock()
+		if id == "" || removed {
+			return nil
+		}
+		ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), removeTimeout)
+		defer cancel()
+		if _, err := e.client.rpc.Remove(ctx, connect.NewRequest(&pluginv1alpha.RemoveRequest{EnvironmentId: id})); err != nil &&
+			connect.CodeOf(err) != connect.CodeNotFound {
+			return e.client.wrap(fmt.Errorf("remove %s: %w", id, err))
+		}
+		return nil
+	}).IfNot(common.Dryrun)
+}
+
+func (e *Environment) Close() common.Executor {
+	return func(context.Context) error {
+		e.client.transport.CloseIdleConnections()
+		return nil
+	}
+}
+
+// ToContainerPath maps a runner-side path into the environment, under the
+// plugin's root path. Paths already inside the root are kept.
+func (e *Environment) ToContainerPath(p string) string {
+	root := e.layout.GetRootPath()
+	if root == "" {
+		root = "/"
+	}
+	p = filepath.ToSlash(p)
+	if p == root || strings.HasPrefix(p, strings.TrimSuffix(root, "/")+"/") {
+		return p
+	}
+	if abs, err := filepath.Abs(filepath.FromSlash(p)); err == nil {
+		p = filepath.ToSlash(abs)
+	}
+	if vol := filepath.VolumeName(p); vol != "" {
+		p = "/" + strings.ToLower(strings.TrimSuffix(vol, ":")) + strings.TrimPrefix(p, vol)
+	}
+	return path.Join(root, p)
+}
+
+func (e *Environment) GetActPath() string { return e.layout.GetActPath() }
+
+func (e *Environment) GetPathVariableName() string {
+	if n := e.layout.GetPathVariableName(); n != "" {
+		return n
+	}
+	return "PATH"
+}
+
+func (e *Environment) DefaultPathVariable() string {
+	if e.layout.DefaultPathVariable != nil {
+		return e.layout.GetDefaultPathVariable()
+	}
+	return defaultPath
+}
+
+func (e *Environment) JoinPathVariable(paths ...string) string {
+	sep := ":"
+	if e.layout.PathSeparator != nil {
+		sep = e.layout.GetPathSeparator()
+	}
+	return strings.Join(paths, sep)
+}
+
+func (e *Environment) GetRunnerContext(context.Context) map[string]any {
+	return map[string]any{
+		"os":         e.layout.GetOs(),
+		"arch":       e.layout.GetArch(),
+		"temp":       e.layout.GetTempPath(),
+		"tool_cache": e.layout.GetToolCachePath(),
+	}
+}
+
+func (e *Environment) IsEnvironmentCaseInsensitive() bool {
+	return e.layout.GetEnvironmentCaseInsensitive()
+}
