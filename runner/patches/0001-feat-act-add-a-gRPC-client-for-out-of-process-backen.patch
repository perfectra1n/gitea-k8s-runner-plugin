+	require.NoError(t, env.Exec([]string{"echo", "hi"}, map[string]string{"K": "v"}, "", "sub")(ctx))
+	assert.Contains(t, out.String(), "hi\n")
+	assert.Contains(t, out.String(), "warn\n")
+	last := f.Execs()[len(f.Execs())-1]
+	assert.Equal(t, "env-1", last.GetEnvironmentId())
+	assert.Equal(t, map[string]string{"K": "v"}, last.GetEnv())
+	assert.Equal(t, "/__w/workspace/owner/repo/sub", last.GetWorkdir(), "relative workdir joins the job workdir")
+	assert.Nil(t, last.User, "empty user is left unset")
+
+	require.NoError(t, env.Exec([]string{"true"}, nil, "", "/abs")(ctx))
+	assert.Equal(t, "/abs", f.Execs()[len(f.Execs())-1].GetWorkdir())
+	require.NoError(t, env.Exec([]string{"true"}, nil, "", "")(ctx))
+	assert.Equal(t, "/__w/workspace/owner/repo", f.Execs()[len(f.Execs())-1].GetWorkdir())
