diff --git a/act/plugin/plugintest/fake.go b/act/plugin/plugintest/fake.go
new file mode 100644
index 0000000..c4f4cd0
--- /dev/null
+++ b/act/plugin/plugintest/fake.go
@@ -0,0 +1,232 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+// Package plugintest provides an in-process backend plugin for tests.
+package plugintest
+
+import (
+	"archive/tar"
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	pluginv1alpha "gitea.com/gitea/runner/act/plugin/proto/v1alpha"
+	"gitea.com/gitea/runner/act/plugin/proto/v1alpha/pluginv1alphaconnect"
+
+	"connectrpc.com/connect"
+	"github.com/stretchr/testify/require"
+)
+
+// Fake is an in-memory backend plugin: environment files live under Root
+// (the environment's "/"), and argv[0] scripts a few commands (echo, exit2,
+// broken, grpc-error); anything else succeeds unless ExecHook says otherwise.
+type Fake struct {
+	pluginv1alphaconnect.UnimplementedBackendPluginHandler
+
+	Root     string
+	ImageEnv map[string]string
+	// ExecHook, if set, runs before the scripted commands; handled=true ends the exec.
+	ExecHook func(req *pluginv1alpha.ExecRequest) (exitCode int32, handled bool)
+
+	mu      sync.Mutex
+	created []*pluginv1alpha.CreateRequest
+	removed []string
+	execs   []*pluginv1alpha.ExecRequest
+}
+
+func (f *Fake) Capabilities(context.Context, *connect.Request[pluginv1alpha.CapabilitiesRequest]) (*connect.Response[pluginv1alpha.CapabilitiesResponse], error) {
+	return connect.NewResponse(&pluginv1alpha.CapabilitiesResponse{Name: "fake"}), nil
+}
+
+func (f *Fake) Create(_ context.Context, req *connect.Request[pluginv1alpha.CreateRequest]) (*connect.Response[pluginv1alpha.CreateResponse], error) {
+	f.mu.Lock()
+	f.created = append(f.created, req.Msg)
+	f.mu.Unlock()
+	return connect.NewResponse(&pluginv1alpha.CreateResponse{
+		EnvironmentId: "env-1",
+		RootPath:      "/__w",
+		ActPath:       "/__w/_act",
+		ToolCachePath: "/__w/_tool",
+		TempPath:      "/__w/_temp",
+		PathSeparator: new(":"),
+		Os:            "Linux",
+		Arch:          "ARM64",
+	}), nil
+}
+
+func (f *Fake) Start(_ context.Context, req *connect.Request[pluginv1alpha.StartRequest], st *connect.ServerStream[pluginv1alpha.StartOutput]) error {
+	if req.Msg.GetEnvironmentId() != "env-1" {
+		return connect.NewError(connect.CodeNotFound, errors.New("unknown environment"))
+	}
+	if err := st.Send(&pluginv1alpha.StartOutput{Output: &pluginv1alpha.StartOutput_Data{Data: &pluginv1alpha.DataChunk{Data: []byte("pod pending\n")}}}); err != nil {
+		return err
+	}
+	return st.Send(&pluginv1alpha.StartOutput{Output: &pluginv1alpha.StartOutput_StartComplete{StartComplete: &pluginv1alpha.StartComplete{ImageEnv: f.ImageEnv}}})
+}
+
+func (f *Fake) Exec(_ context.Context, req *connect.Request[pluginv1alpha.ExecRequest], st *connect.ServerStream[pluginv1alpha.ExecOutput]) error {
+	f.mu.Lock()
+	f.execs = append(f.execs, req.Msg)
+	f.mu.Unlock()
+	data := func(s pluginv1alpha.DataChunk_Stream, b string) error {
+		return st.Send(&pluginv1alpha.ExecOutput{Output: &pluginv1alpha.ExecOutput_Data{Data: &pluginv1alpha.DataChunk{Stream: s, Data: []byte(b)}}})
+	}
+	done := func(code int32) error {
+		return st.Send(&pluginv1alpha.ExecOutput{Output: &pluginv1alpha.ExecOutput_ExecComplete{ExecComplete: &pluginv1alpha.ExecComplete{ExitCode: code}}})
+	}
+	if f.ExecHook != nil {
+		if code, handled := f.ExecHook(req.Msg); handled {
+			return done(code)
+		}
+	}
+	switch req.Msg.GetCommand()[0] {
+	case "echo":
+		if err := data(pluginv1alpha.DataChunk_STDOUT, strings.Join(req.Msg.GetCommand()[1:], " ")+"\n"); err != nil {
+			return err
+		}
+		if err := data(pluginv1alpha.DataChunk_STDERR, "warn\n"); err != nil {
+			return err
+		}
+		return done(0)
+	case "exit2":
+		return done(2)
+	case "broken":
+		return st.Send(&pluginv1alpha.ExecOutput{Output: &pluginv1alpha.ExecOutput_ExecFailed{ExecFailed: &pluginv1alpha.ExecFailed{ErrorMessage: "pod evicted"}}})
+	case "grpc-error":
+		return connect.NewError(connect.CodeUnavailable, errors.New("plugin went away"))
+	}
+	return done(0)
+}
+
+func (f *Fake) CopyIn(_ context.Context, st *connect.ClientStream[pluginv1alpha.CopyInChunk]) (*connect.Response[pluginv1alpha.CopyInResponse], error) {
+	var dest string
+	var buf bytes.Buffer
+	first := true
+	for st.Receive() {
+		m := st.Msg()
+		if first {
+			if m.EnvironmentId == nil || m.DestPath == nil {
+				return nil, connect.NewError(connect.CodeInvalidArgument, errors.New("first chunk needs env id and dest"))
+			}
+			dest = m.GetDestPath()
+			first = false
+		} else if m.EnvironmentId != nil || m.DestPath != nil {
+			return nil, connect.NewError(connect.CodeInvalidArgument, errors.New("env id/dest only on the first chunk"))
+		}
+		buf.Write(m.GetData())
+	}
+	if err := st.Err(); err != nil {
+		return nil, err
+	}
+	if err := untar(&buf, filepath.Join(f.Root, dest)); err != nil {
+		return nil, connect.NewError(connect.CodeInternal, err)
+	}
+	return connect.NewResponse(&pluginv1alpha.CopyInResponse{}), nil
+}
+
+func (f *Fake) CopyOut(_ context.Context, req *connect.Request[pluginv1alpha.CopyOutRequest], st *connect.ServerStream[pluginv1alpha.CopyOutChunk]) error {
+	src := filepath.Join(f.Root, req.Msg.GetSrcPath())
+	b, err := os.ReadFile(src)
+	if err != nil {
+		return connect.NewError(connect.CodeNotFound, err)
+	}
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	_ = tw.WriteHeader(&tar.Header{Name: filepath.Base(src), Mode: 0o644, Size: int64(len(b))})
+	_, _ = tw.Write(b)
+	_ = tw.Close()
+	// Two chunks, so the client has to stitch them.
+	all := buf.Bytes()
+	for _, part := range [][]byte{all[:len(all)/2], all[len(all)/2:]} {
+		if err := st.Send(&pluginv1alpha.CopyOutChunk{Data: part}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (f *Fake) Remove(_ context.Context, req *connect.Request[pluginv1alpha.RemoveRequest]) (*connect.Response[pluginv1alpha.RemoveResponse], error) {
+	f.mu.Lock()
+	f.removed = append(f.removed, req.Msg.GetEnvironmentId())
+	f.mu.Unlock()
+	return connect.NewResponse(&pluginv1alpha.RemoveResponse{}), nil
+}
+
+func untar(r io.Reader, dest string) error {
+	tr := tar.NewReader(r)
+	for {
+		h, err := tr.Next()
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		p := filepath.Join(dest, h.Name)
+		switch h.Typeflag {
+		case tar.TypeDir:
+			if err := os.MkdirAll(p, 0o755); err != nil {
+				return err
+			}
+		case tar.TypeReg:
+			if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+				return err
+			}
+			b, err := io.ReadAll(tr)
+			if err != nil {
+				return err
+			}
+			if err := os.WriteFile(p, b, os.FileMode(h.Mode)); err != nil {
+				return err
+			}
+		}
+	}
+}
+
+// Created returns the Create requests received so far.
+func (f *Fake) Created() []*pluginv1alpha.CreateRequest {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]*pluginv1alpha.CreateRequest(nil), f.created...)
+}
+
+// Execs returns the Exec requests received so far.
+func (f *Fake) Execs() []*pluginv1alpha.ExecRequest {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]*pluginv1alpha.ExecRequest(nil), f.execs...)
+}
+
+// Removed returns the environment ids removed so far.
+func (f *Fake) Removed() []string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]string(nil), f.removed...)
+}
+
+// Serve serves f over h2c on a unix socket and returns its "unix://" address.
+func Serve(t testing.TB, f *Fake) string {
+	t.Helper()
+	if f.Root == "" {
+		f.Root = t.TempDir()
+	}
+	sock := filepath.Join(t.TempDir(), "plugin.sock")
+	lis, err := net.Listen("unix", sock)
+	require.NoError(t, err)
+	mux := http.NewServeMux()
+	mux.Handle(pluginv1alphaconnect.NewBackendPluginHandler(f))
+	p := new(http.Protocols)
+	p.SetUnencryptedHTTP2(true)
+	srv := &http.Server{Handler: mux, Protocols: p}
+	go func() { _ = srv.Serve(lis) }()
+	t.Cleanup(func() { _ = srv.Close() })
+	return "unix://" + sock
+}
