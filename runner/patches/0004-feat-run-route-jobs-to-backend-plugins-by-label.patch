@@ -375,6 +376,18 @@ var dockerReachable = func(ctx context.Context) bool {
 	return envcheck.CheckIfDockerRunning(ctx, "") == nil
 }
 
+// pluginConfigs converts the configured backend plugins for act.
+func (r *Runner) pluginConfigs() map[string]runner.PluginConfig {
+	if len(r.cfg.Plugins) == 0 {
+		return nil
+	}
+	out := make(map[string]runner.PluginConfig, len(r.cfg.Plugins))
+	for name, p := range r.cfg.Plugins {
+		out[name] = runner.PluginConfig{Address: p.Address, Options: p.Options}
+	}
+	return out
+}
+
 func (r *Runner) requiresDocker() bool {
 	return r.labels.RequireDocker() || r.cfg.Container.RequireDocker
 }
