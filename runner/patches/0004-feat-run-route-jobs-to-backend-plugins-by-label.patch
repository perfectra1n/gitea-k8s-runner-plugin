@@ -0,0 +1,37 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package run
+
+import (
+	"testing"
+
+	"gitea.com/gitea/runner/act/runner"
+	clientmocks "gitea.com/gitea/runner/internal/pkg/client/mocks"
+	"gitea.com/gitea/runner/internal/pkg/config"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewRunnerRoutesPluginLabels(t *testing.T) {
+	cacheEnabled := false
+	cfg := &config.Config{Plugins: map[string]config.Plugin{
+		"k8s": {Address: "unix:///run/plugin/plugin.sock", Options: map[string]string{"namespace": "ci"}},
+	}}
+	cfg.Cache.Enabled = &cacheEnabled
+	reg := &config.Registration{Name: "runner", Labels: []string{"small:k8s:/podspecs/small.yaml", "ubuntu:host", "pool:e57e18d4"}}
+	cli := clientmocks.NewClient(t)
+	cli.AddressValue = "https://gitea.example/"
+
+	r := NewRunner(cfg, reg, cli)
+
+	require.Equal(t, []string{"small", "ubuntu", "pool:e57e18d4"}, r.labels.Names())
+	require.False(t, r.requiresDocker(), "a plugin-only runner needs no docker daemon")
+	plugin, arg, ok := r.labels.PickBackend([]string{"small"})
+	require.True(t, ok)
+	require.Equal(t, "k8s", plugin)
+	require.Equal(t, "/podspecs/small.yaml", arg)
+	require.Equal(t, map[string]runner.PluginConfig{
+		"k8s": {Address: "unix:///run/plugin/plugin.sock", Options: map[string]string{"namespace": "ci"}},
+	}, r.pluginConfigs())
+}
