+// registeredLabelNames returns the label names Gitea matches runs-on against.
+func registeredLabelNames(ls []string, plugins map[string]bool) ([]string, error) {
+	names := make([]string, len(ls))
+	for i, v := range ls {
+		l, err := labels.ParseWith(v, plugins)
+		if err != nil {
+			return nil, fmt.Errorf("failed to parse label %q: %w", v, err)
+		}
+		names[i] = l.Name
+	}
+	return names, nil
+}
+
 func validateLabels(ls []string) error {
 	for _, label := range ls {
 		if _, err := labels.Parse(label); err != nil {
