diff --git a/act/runner/plugin_environment.go b/act/runner/plugin_environment.go
new file mode 100644
index 0000000..955d5f4
--- /dev/null
+++ b/act/runner/plugin_environment.go
@@ -0,0 +1,145 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package runner
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"gitea.com/gitea/runner/act/common"
+	"gitea.com/gitea/runner/act/container"
+	"gitea.com/gitea/runner/act/plugin"
+)
+
+// IsPluginEnv reports whether the job runs on a backend plugin.
+func (rc *RunContext) IsPluginEnv() bool {
+	return rc.pluginName != ""
+}
+
+// refuseDockerOnPlugin fails docker-backed steps (docker:// and Dockerfile actions), which
+// need a Docker daemon the plugin environment does not have.
+func (rc *RunContext) refuseDockerOnPlugin() error {
+	if !rc.IsPluginEnv() {
+		return nil
+	}
+	return fmt.Errorf("docker actions are not supported on the %s backend plugin", rc.pluginName)
+}
+
+// resolveBackend picks the backend plugin for the job's runs-on, if any.
+func (rc *RunContext) resolveBackend(ctx context.Context) {
+	if rc.Config.BackendPicker == nil || rc.Run.Job().RunsOn() == nil {
+		return
+	}
+	if name, arg, ok := rc.Config.BackendPicker(rc.runsOnPlatformNames(ctx)); ok {
+		rc.pluginName, rc.pluginArg = name, arg
+	}
+}
+
+func (rc *RunContext) startPluginEnvironment() common.Executor {
+	return func(ctx context.Context) error {
+		logger := common.Logger(ctx)
+		cfg, ok := rc.Config.Plugins[rc.pluginName]
+		if !ok {
+			return fmt.Errorf("no backend plugin %q is configured", rc.pluginName)
+		}
+		username, password, err := rc.handleCredentials(ctx)
+		if err != nil {
+			return fmt.Errorf("failed to handle credentials: %w", err)
+		}
+		if username != "" || password != "" {
+			logger.Warnf("container.credentials are ignored on the %s backend plugin, give the plugin its own image pull credentials", rc.pluginName)
+		}
+		services, err := rc.pluginServices(ctx)
+		if err != nil {
+			return err
+		}
+		client, err := plugin.Dial(ctx, rc.pluginName, cfg.Address)
+		if err != nil {
+			return err
+		}
+
+		logWriter := rc.commandLogWriter(ctx)
+		env := client.NewEnvironment(&container.NewContainerInput{
+			Image:      rc.platformImage,
+			Name:       rc.jobContainerName(),
+			WorkingDir: rc.Config.Workdir,
+			Stdout:     logWriter,
+			Stderr:     logWriter,
+		}, services, cfg.Options, rc.pluginArg, rc.Config.ContainerMaxLifetime)
+		rc.JobContainer = env
+		rc.cleanUpJobContainer = func(ctx context.Context) error {
+			return errors.Join(env.Remove()(ctx), env.Close()(ctx))
+		}
+
+		if _, ok := rc.Env["LANG"]; !ok {
+			rc.Env["LANG"] = "C.UTF-8" // what the docker backend gives job containers
+		}
+		defer printStartJobContainerGroup(ctx, rc.platformImage, rc.jobContainerName(), "backend plugin "+rc.pluginName)()
+		return common.NewPipelineExecutor(
+			env.Create(rc.Config.ContainerCapAdd, rc.Config.ContainerCapDrop),
+			env.Start(false),
+			func(ctx context.Context) error {
+				for k, v := range rc.getRunnerContext(ctx) {
+					if v, ok := v.(string); ok {
+						rc.Env["RUNNER_"+strings.ToUpper(k)] = v
+					}
+				}
+				// The act path is only known once the plugin created the environment.
+				return env.Copy(env.GetActPath()+"/", &container.FileEntry{
+					Name: "workflow/event.json",
+					Mode: 0o644,
+					Body: rc.EventJSON,
+				}, &container.FileEntry{
+					Name: "workflow/envs.txt",
+					Mode: 0o666,
+					Body: "",
+				})(ctx)
+			},
+		)(ctx)
+	}
+}
+
+// pluginServices interpolates the job's services for the plugin. Options the plugin
+// protocol cannot carry are dropped with a warning.
+func (rc *RunContext) pluginServices(ctx context.Context) ([]plugin.ServiceSpec, error) {
+	logger := common.Logger(ctx)
+	services := rc.Run.Job().Services
+	if err := decodeDeferred(ctx, rc.ExprEval, "job services", rc.Run.Job().RawServices, &services); err != nil {
+		return nil, err
+	}
+	specs := make([]plugin.ServiceSpec, 0, len(services))
+	for _, id := range slices.Sorted(maps.Keys(services)) {
+		spec := services[id]
+		image, err := rc.ExprEval.Interpolate(ctx, spec.Image)
+		if err != nil {
+			return nil, fmt.Errorf("unable to interpolate service %s image: %w", id, err)
+		}
+		if image == "" {
+			logger.Infof("The service '%s' will not be started because the container definition has an empty image.", id)
+			continue
+		}
+		env := make(map[string]string, len(spec.Env)+len(rc.Config.ProxyEnv))
+		maps.Copy(env, rc.Config.ProxyEnv)
+		for k, v := range spec.Env {
+			if env[k], err = rc.ExprEval.Interpolate(ctx, v); err != nil {
+				return nil, fmt.Errorf("unable to interpolate service %s env %s: %w", id, k, err)
+			}
+		}
+		ports := make([]string, len(spec.Ports))
+		for i, p := range spec.Ports {
+			if ports[i], err = rc.ExprEval.Interpolate(ctx, p); err != nil {
+				return nil, fmt.Errorf("unable to interpolate service %s ports: %w", id, err)
+			}
+		}
+		if len(spec.Credentials) > 0 || len(spec.Volumes) > 0 || len(spec.Cmd) > 0 || spec.Options != "" {
+			logger.Warnf("service %s: credentials, volumes, command and options are ignored on the %s backend plugin", id, rc.pluginName)
+		}
+		specs = append(specs, plugin.ServiceSpec{Name: id, Image: image, Env: env, Ports: ports})
+	}
+	return specs, nil
+}
