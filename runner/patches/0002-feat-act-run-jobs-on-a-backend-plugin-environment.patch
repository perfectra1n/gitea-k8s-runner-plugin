@@ -0,0 +1,106 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package runner
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+	"time"
+
+	"gitea.com/gitea/runner/act/plugin/plugintest"
+
+	"gitea.dev/actionslib/pkg/model"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func runPluginWorkflow(t *testing.T, f *plugintest.Fake, workflow string, pick func([]string) (string, string, bool)) error {
+	t.Helper()
+	addr := plugintest.Serve(t, f)
+	wd, err := filepath.Abs(workdir)
+	require.NoError(t, err)
+	r, err := New(&Config{
+		Workdir:              wd,
+		EventName:            "push",
+		ContainerNamePrefix:  "GITEA-ACTIONS-TASK-7",
+		ContainerMaxLifetime: time.Hour,
+		GitHubInstance:       "github.com",
+		PlatformPicker:       func([]string) string { return "" },
+		Plugins:              map[string]PluginConfig{"fake": {Address: addr, Options: map[string]string{"namespace": "ci"}}},
+		BackendPicker:        pick,
+	})
+	require.NoError(t, err)
+	planner, err := model.NewWorkflowPlanner(filepath.Join(wd, workflow), true)
+	require.NoError(t, err)
+	plan, err := planner.PlanEvent("push")
+	require.NoError(t, err)
+	return r.NewPlanExecutor(plan)(context.Background())
+}
+
+func pickFake(runsOn []string) (string, string, bool) {
+	if slices.Contains(runsOn, "k8s-small") {
+		return "fake", "/podspecs/small.yaml", true
+	}
+	return "", "", false
+}
+
+func TestPluginEnvironment(t *testing.T) {
+	f := &plugintest.Fake{}
+	require.NoError(t, runPluginWorkflow(t, f, "plugin-env", pickFake))
+
+	created := f.Created()
+	require.Len(t, created, 1)
+	req := created[0]
+	assert.Equal(t, "alpine:latest", req.GetImage(), "container: image is interpolated and sent")
+	assert.Equal(t, "/podspecs/small.yaml", req.GetLabelArg())
+	assert.Equal(t, map[string]string{"namespace": "ci"}, req.GetBackendOptions())
+	assert.Equal(t, time.Hour, req.GetEnvironmentTimeout().AsDuration())
+	require.Len(t, req.GetServices(), 1, "a service whose image evaluates empty is skipped")
+	svc := req.GetServices()[0]
+	assert.Equal(t, "postgres", svc.GetName())
+	assert.Equal(t, "postgres:17", svc.GetImage())
+	assert.Equal(t, "pw", svc.GetEnv()["POSTGRES_PASSWORD"])
+	assert.Equal(t, []string{"5432"}, svc.GetPorts())
+
+	event, err := os.ReadFile(filepath.Join(f.Root, "__w/_act/workflow/event.json"))
+	require.NoError(t, err, "event.json is copied into the act path")
+	assert.NotEmpty(t, event)
+	assert.FileExists(t, filepath.Join(f.Root, "__w/_act/workflow/envs.txt"))
+
+	var sawStep bool
+	for _, e := range f.Execs() {
+		if e.GetEnv()["RUNNER_TEMP"] == "/__w/_temp" && e.GetEnv()["RUNNER_OS"] == "Linux" {
+			sawStep = true
+			assert.NotContains(t, e.GetEnv(), "JOB_CONTAINER_NAME", "docker-only variable")
+		}
+	}
+	assert.True(t, sawStep, "steps run through the plugin with RUNNER_* from the plugin layout: %v", f.Execs())
+	assert.Equal(t, []string{"env-1"}, f.Removed(), "the environment is removed at job end")
+}
+
+func TestPluginEnvironmentRefusesDockerSteps(t *testing.T) {
+	f := &plugintest.Fake{}
+	err := runPluginWorkflow(t, f, "plugin-docker-step", pickFake)
+	require.Error(t, err)
+	assert.Equal(t, []string{"env-1"}, f.Removed(), "the environment is still removed")
+}
+
+func TestPluginEnvironmentUnknownPlugin(t *testing.T) {
+	f := &plugintest.Fake{}
+	err := runPluginWorkflow(t, f, "plugin-env", func([]string) (string, string, bool) { return "missing", "", true })
+	require.ErrorContains(t, err, `no backend plugin "missing" is configured`)
+	assert.Empty(t, f.Created())
+}
+
+func TestIsPluginEnv(t *testing.T) {
+	rc := &RunContext{}
+	assert.False(t, rc.IsPluginEnv())
+	rc.pluginName = "k8s"
+	assert.True(t, rc.IsPluginEnv())
+	assert.False(t, rc.IsHostEnv(), "a plugin environment is not a host environment")
+	assert.EqualError(t, rc.refuseDockerOnPlugin(), "docker actions are not supported on the k8s backend plugin")
+}
