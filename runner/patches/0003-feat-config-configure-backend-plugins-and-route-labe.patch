From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: perfectra1n <jonfuller2012@gmail.com>
Date: Wed, 23 Sep 2026 12:17:36 -0700
Subject: [PATCH 3/4] feat(config): configure backend plugins and route labels
 to them

A top-level plugins map names each backend plugin and its address and
options. Labels may use a configured plugin name as their schema,
"<name>:<plugin>[:<arg>]"; an unconfigured middle segment still makes the
label opaque. Plugin labels need no Docker daemon.

Assisted-by: Claude Code:claude-opus-5-5

diff --git a/internal/pkg/config/config.example.yaml b/internal/pkg/config/config.example.yaml
index 5cdd237..7bca6af 100644
--- a/internal/pkg/config/config.example.yaml
+++ b/internal/pkg/config/config.example.yaml
@@ -300,3 +300,15 @@ metrics:
   #addr: "127.0.0.1:9101"
   # Consecutive polling failures may last this long before /readyz returns 503.
   #readiness_grace: 30s
+
+# Out-of-process backend plugins, which run jobs in environments they own (a
+# Kubernetes pod, a VM, ...). A runner label "<name>:<plugin>[:<arg>]" routes
+# jobs to the plugin, passing <arg> along. The protocol is plugin.v1alpha,
+# compatible with Forgejo runner's backend plugins.
+#plugins:
+#  k8s:
+#    # unix:///path or tcp://host:port, plain gRPC without TLS.
+#    address: unix:///run/plugin/plugin.sock
+#    # Passed to the plugin verbatim for every job.
+#    options:
+#      namespace: ci
diff --git a/internal/pkg/config/config.go b/internal/pkg/config/config.go
index c6aab9f..ccdcb15 100644
--- a/internal/pkg/config/config.go
+++ b/internal/pkg/config/config.go
@@ -205,6 +205,39 @@ type Config struct {
 	Host        Host        `yaml:"host"`         // Host represents the configuration for the host.
 	Metrics     Metrics     `yaml:"metrics"`      // Metrics represents the configuration for the Prometheus metrics endpoint.
 	HealthCheck HealthCheck `yaml:"health_check"` // HealthCheck controls opt-in local task-admission checks.
+	// Plugins are out-of-process backend plugins, by the name labels use as their schema.
+	Plugins map[string]Plugin `yaml:"plugins"`
+}
+
+// Plugin is how to reach one backend plugin.
+type Plugin struct {
+	Address string            `yaml:"address"` // unix:///path or tcp://host:port
+	Options map[string]string `yaml:"options"` // passed verbatim to the plugin for every job
+}
+
+// PluginNames returns the configured plugin names, the extra schemas labels may use.
+func (c *Config) PluginNames() map[string]bool {
+	names := make(map[string]bool, len(c.Plugins))
+	for name := range c.Plugins {
+		names[name] = true
+	}
+	return names
+}
+
+func validatePlugins(plugins map[string]Plugin) error {
+	for name, p := range plugins {
+		switch {
+		case name == "" || strings.Contains(name, ":"):
+			return fmt.Errorf("plugins.%s: a plugin name must be non-empty and contain no colon", name)
+		case name == "host" || name == "docker":
+			return fmt.Errorf("plugins.%s: %q is a built-in label schema", name, name)
+		case p.Address == "":
+			return fmt.Errorf("plugins.%s.address is required", name)
+		case !strings.HasPrefix(p.Address, "unix://") && !strings.HasPrefix(p.Address, "tcp://"):
+			return fmt.Errorf("plugins.%s.address %q must be unix:///path or tcp://host:port", name, p.Address)
+		}
+	}
+	return nil
 }
 
 // LoadDefault returns the default configuration.
@@ -284,6 +317,9 @@ func LoadDefault(file string) (*Config, error) {
 	if cfg.Container.WorkdirParent == "" {
 		cfg.Container.WorkdirParent = "workspace"
 	}
+	if err := validatePlugins(cfg.Plugins); err != nil {
+		return nil, err
+	}
 	if cfg.Runner.DefaultImage == "" {
 		cfg.Runner.DefaultImage = DefaultImage
 	}
diff --git a/internal/pkg/config/plugins_test.go b/internal/pkg/config/plugins_test.go
new file mode 100644
index 0000000..c2d007d
--- /dev/null
+++ b/internal/pkg/config/plugins_test.go
@@ -0,0 +1,56 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func loadYAML(t *testing.T, content string) (*Config, error) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	require.NoError(t, os.WriteFile(path, []byte(content), 0o600))
+	return LoadDefault(path)
+}
+
+func TestLoadDefault_Plugins(t *testing.T) {
+	cfg, err := loadYAML(t, `
+plugins:
+  k8s:
+    address: unix:///run/plugin/plugin.sock
+    options:
+      namespace: ci
+      ready_timeout: 15m
+`)
+	require.NoError(t, err)
+	assert.Equal(t, map[string]Plugin{"k8s": {
+		Address: "unix:///run/plugin/plugin.sock",
+		Options: map[string]string{"namespace": "ci", "ready_timeout": "15m"},
+	}}, cfg.Plugins)
+	assert.Equal(t, map[string]bool{"k8s": true}, cfg.PluginNames())
+
+	cfg, err = LoadDefault("")
+	require.NoError(t, err)
+	assert.Empty(t, cfg.PluginNames())
+}
+
+func TestLoadDefault_PluginErrors(t *testing.T) {
+	for name, content := range map[string]string{
+		"no address":        "plugins:\n  k8s:\n    options: {a: b}\n",
+		"built-in name":     "plugins:\n  docker:\n    address: unix:///x.sock\n",
+		"name with a colon": "plugins:\n  \"a:b\":\n    address: unix:///x.sock\n",
+		"bad scheme":        "plugins:\n  k8s:\n    address: http://x\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			_, err := loadYAML(t, content)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "plugins.")
+		})
+	}
+}
