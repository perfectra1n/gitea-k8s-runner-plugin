diff --git a/internal/pkg/labels/plugin_labels_test.go b/internal/pkg/labels/plugin_labels_test.go
new file mode 100644
index 0000000..96aa126
--- /dev/null
+++ b/internal/pkg/labels/plugin_labels_test.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package labels
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseWithPlugins(t *testing.T) {
+	plugins := map[string]bool{"k8s": true}
+
+	l, err := ParseWith("small:k8s:/podspecs/small/podspec.yaml", plugins)
+	require.NoError(t, err)
+	assert.Equal(t, &Label{Name: "small", Schema: "k8s", Arg: "/podspecs/small/podspec.yaml"}, l)
+
+	l, err = ParseWith("small:k8s", plugins)
+	require.NoError(t, err)
+	assert.Equal(t, &Label{Name: "small", Schema: "k8s"}, l)
+
+	// Built-in schemas are unaffected.
+	l, err = ParseWith("ubuntu:docker://node:18", plugins)
+	require.NoError(t, err)
+	assert.Equal(t, "docker", l.Schema)
+
+	// Without the plugin configured the label is opaque, as before.
+	l, err = Parse("small:k8s:/podspecs/small/podspec.yaml")
+	require.NoError(t, err)
+	assert.True(t, l.Opaque)
+	assert.Equal(t, SchemeHost, l.Schema)
+}
+
+// An unconfigured middle segment keeps the label opaque (e.g. a pool id).
+func TestParseWithUnconfiguredSchemaIsOpaque(t *testing.T) {
+	l, err := ParseWith("pool:e57e18d4-2f5c-4d67-9f7e-0f2b6c3f1a90", map[string]bool{"k8s": true})
+	require.NoError(t, err)
+	assert.Equal(t, &Label{Name: "pool:e57e18d4-2f5c-4d67-9f7e-0f2b6c3f1a90", Schema: SchemeHost, Opaque: true}, l)
+}
+
+func TestPluginLabelsRoundTripAndDocker(t *testing.T) {
+	plugins := map[string]bool{"k8s": true}
+	var ls Labels
+	for _, s := range []string{"small:k8s:/podspecs/small/podspec.yaml", "pool:abc"} {
+		l, err := ParseWith(s, plugins)
+		require.NoError(t, err)
+		ls = append(ls, l)
+	}
+	assert.Equal(t, []string{"small:k8s:/podspecs/small/podspec.yaml", "pool:abc"}, ls.ToStrings())
+	assert.Equal(t, []string{"small", "pool:abc"}, ls.Names())
+	assert.False(t, ls.RequireDocker(), "plugin labels need no docker daemon")
+	assert.Empty(t, ls.PickPlatform([]string{"small"}), "a plugin label is not a platform")
+}
+
+func TestPickBackend(t *testing.T) {
+	plugins := map[string]bool{"k8s": true, "vm": true}
+	var ls Labels
+	for _, s := range []string{"ubuntu:docker://node:18", "small:k8s:/a", "big:vm:/b", "bare:k8s"} {
+		l, err := ParseWith(s, plugins)
+		require.NoError(t, err)
+		ls = append(ls, l)
+	}
+	tests := []struct {
+		runsOn           []string
+		wantPlugin, want string
+		wantOK           bool
+	}{
+		{[]string{"big", "small"}, "vm", "/b", true},
+		{[]string{"small"}, "k8s", "/a", true},
+		{[]string{"bare"}, "k8s", "", true},
+		{[]string{"unknown", "small"}, "k8s", "/a", true},
+		// The first runs-on entry this runner has a label for decides, like PickPlatform.
+		{[]string{"ubuntu", "small"}, "", "", false},
+		{[]string{"unknown"}, "", "", false},
+		{nil, "", "", false},
+	}
+	for _, tt := range tests {
+		p, a, ok := ls.PickBackend(tt.runsOn)
+		assert.Equal(t, tt.wantOK, ok, "%v", tt.runsOn)
+		assert.Equal(t, tt.wantPlugin, p, "%v", tt.runsOn)
+		assert.Equal(t, tt.want, a, "%v", tt.runsOn)
+	}
+}
