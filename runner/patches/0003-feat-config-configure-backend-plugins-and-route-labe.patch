+// IsPlugin reports whether the label routes jobs to a backend plugin.
+func (l *Label) IsPlugin() bool {
+	return l.Schema != SchemeHost && l.Schema != SchemeDocker
+}
+
+// PickBackend returns the plugin and its argument when the first runs-on entry this
+// runner has a label for is a plugin label; the same precedence as PickPlatform.
+func (l Labels) PickBackend(runsOn []string) (plugin, arg string, ok bool) {
+	for _, v := range runsOn {
+		for _, label := range l {
+			if label.Name != v {
+				continue
+			}
+			if label.IsPlugin() {
+				return label.Schema, label.Arg, true
+			}
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
+
